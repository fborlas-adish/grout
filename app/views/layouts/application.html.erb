<!DOCTYPE html>
<html>
  <head>
    <title>Grout</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag 'application', media: 'all' %>
    <%= javascript_pack_tag "application" %>
  </head>

  <body class="bg-purple-300">
    <div class="absolute top-4 left-1/2 transform -translate-x-1/2 w-full max-w-md z-50">
      <% if notice %>
        <div class="flash-message bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4 text-center shadow-md relative" role="alert">
          <button type="button" class="absolute top-1 right-2 text-green-700 text-xl leading-none focus:outline-none close-flash" data-target="notice">
            &times;
          </button>
          <span class="block sm:inline"><%= notice %></span>
        </div>
      <% end %>

      <% if alert %>
        <div class="flash-message bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 text-center shadow-md relative" role="alert">
          <button type="button" class="absolute top-1 right-2 text-red-700 text-xl leading-none focus:outline-none close-flash" data-target="alert">
            &times;
          </button>
          <span class="block sm:inline"><%= alert %></span>
        </div>
      <% end %>
    </div>

    <% if user_signed_in? %>
      <%= react_component("shared/Navbar", {
          logoutPath: destroy_user_session_path,
          csrfToken: form_authenticity_token
        }) 
      %>
    <% end %>
    <div class="p-5">
      <%= yield %>
    </div>
  </body>
</html>
