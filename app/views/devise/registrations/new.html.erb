<div class="h-screen flex items-center justify-center bg-purple-300">
  <div class="w-[40vw] mx-auto bg-white p-16 rounded-lg shadow-md">
    <h2 class="font-bold text-2xl text-gray-700">Sign up</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: 'flex flex-col items-center justify-center'}) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="w-full mb-3">
        <%= f.label :email, class: 'text-gray-700' %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: 'w-full rounded-md border-purple-200 text-gray-700 focus:border-purple-700 focus:outline-none' %>
      </div>

      <div class="w-full mb-3">
        <%= f.label :password, class: 'text-gray-700' %>
        <% if @minimum_password_length %>
        <em class="text-gray-700">(<%= @minimum_password_length %> characters minimum)</em>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password", class: 'w-full rounded-md border-purple-200 text-gray-700 focus:border-purple-700 focus:outline-none' %>
      </div>

      <div class="w-full mb-6">
        <%= f.label :password_confirmation, class: 'text-gray-700' %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: 'w-full rounded-md border-purple-200 text-gray-700 focus:border-purple-700 focus:outline-none' %>
      </div>

      <button class="border rounded-md border-purple-200 text-gray-700 hover:border-transparent hover:bg-purple-600 hover:text-white active:bg-purple-700 py-1 w-full mb-3">
        <%= f.submit "Sign up" %>
      </button>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
